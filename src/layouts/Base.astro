---
import '../styles/global.css';
import { site } from '../site';

interface Props {
  title?: string;
  description?: string;
}

const { title = `${site.name}: search digital collections with little or no metadata`, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareSourceCode',
      '@id': `${site.url}/#software`,
      name: site.name,
      description: site.description,
      url: site.url,
      codeRepository: site.repoUrl,
      programmingLanguage: ['Python', 'JavaScript'],
      runtimePlatform: 'Docker',
      license: site.license.url,
      isAccessibleForFree: true,
      applicationCategory: 'Search engine for digital collections',
      keywords: 'digital collections, digital libraries, cultural heritage, GLAM, multimodal search, CLIP, SigLIP, reverse image search',
      author: { '@id': `${site.url}/#lab` },
      citation: { '@id': `${site.url}/#paper` },
      sameAs: [site.repoUrl, site.zenodoUrl],
    },
    {
      '@type': 'Organization',
      '@id': `${site.url}/#lab`,
      name: site.lab.name,
      alternateName: site.lab.short,
      url: site.lab.url,
      parentOrganization: { '@type': 'CollegeOrUniversity', name: site.lab.institution, url: site.lab.institutionUrl },
    },
    {
      '@type': 'ScholarlyArticle',
      '@id': `${site.url}/#paper`,
      headline: site.paper.title,
      url: site.paper.url,
      identifier: `doi:${site.paper.doi}`,
      isPartOf: { '@type': 'Periodical', name: site.paper.journal },
      sameAs: site.paper.arxivUrl,
      datePublished: String(site.paper.year),
      author: site.paper.authors.map((name) => ({ '@type': 'Person', name })),
    },
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      name: site.name,
      url: site.url,
      about: { '@id': `${site.url}/#software` },
    },
  ],
};

const nav = [
  ['#who', 'Who it is for'],
  ['#how', 'How it works'],
  ['#templates', 'Templates'],
  ['#start', 'Get started'],
  ['#community', 'Community'],
  ['/docs/', 'Docs'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Kumbh+Sans:wght@400;700&family=Lato:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="header">
      <div class="wrap header-inner">
        <a class="brand" href="/" aria-label={`${site.name} home`}>
          <span class="brand-mark" aria-hidden="true"></span>
          <span>{site.name}</span>
        </a>
        <div class="header-end">
          <nav aria-label="Sections">
            <ul class="nav-links">
              {nav.map(([href, label]) => (
                <li><a href={href}>{label}</a></li>
              ))}
            </ul>
            <details class="menu">
              <summary>Menu</summary>
              <ul>
                {nav.map(([href, label]) => (
                  <li><a href={href}>{label}</a></li>
                ))}
              </ul>
            </details>
          </nav>
          <a class="github" href={site.repoUrl} rel="noopener" aria-label="GitHub" title="GitHub">
            <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true">
              <path fill="currentColor" d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z" />
            </svg>
          </a>
        </div>
        <script>
          const menu = document.querySelector<HTMLDetailsElement>('details.menu');
          menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => menu.removeAttribute('open')));
        </script>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap footer-inner">
        <div>
          <p>
            <strong>{site.name}</strong> started at the <a href={site.lab.url} rel="noopener">{site.lab.name}</a>, {site.lab.institution},
            and is developed in the open. <a href={site.contributingUrl} rel="noopener">Contributions are welcome</a>.
          </p>
          <p class="faint">
            Code under <a href={site.license.url} rel="license noopener">{site.license.name}</a>. Paper and figures under CC BY 4.0.
          </p>
        </div>
        <ul class="footer-links">
          <li><a href={site.paper.url} rel="noopener">Paper</a></li>
          <li><a href={site.zenodoUrl} rel="noopener">Zenodo DOI</a></li>
          <li><a href={site.discussionsUrl} rel="noopener">Discussions</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -999px;
    top: 8px;
    background: var(--accent);
    color: var(--accent-ink);
    padding: 8px 12px;
    border-radius: 6px;
    z-index: 10;
  }
  .skip:focus { left: 8px; }
  .header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 60px; }
  .header-end { display: flex; align-items: center; gap: 20px; }
  .github { display: inline-grid; place-items: center; width: 36px; height: 36px; border-radius: 999px; color: var(--ink-soft); }
  .github:hover { color: var(--ink); background: var(--bg-sunken); }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-display); font-weight: 700; color: var(--ink); text-decoration: none; white-space: nowrap; }
  .brand-mark { position: relative; width: 20px; height: 20px; flex: none; }
  .brand-mark::before, .brand-mark::after { content: ''; position: absolute; width: 10px; height: 10px; border-radius: 2px; background: var(--accent); }
  .brand-mark::before { top: 7px; left: 7px; opacity: 0.55; }
  .brand-mark::after { top: 2px; left: 2px; }
  nav ul { list-style: none; margin: 0; padding: 0; }
  .nav-links { display: flex; align-items: center; gap: 18px; }
  .nav-links li { margin: 0; }
  nav a { color: var(--ink-soft); text-decoration: none; font-size: 0.95rem; white-space: nowrap; }
  nav a:hover { color: var(--ink); text-decoration: underline; }
  .menu { display: none; }
  .menu summary {
    list-style: none;
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--ink);
    padding: 8px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-raised);
  }
  .menu summary::-webkit-details-marker { display: none; }
  .menu[open] summary { background: var(--accent-soft); border-color: var(--accent); }
  .menu ul {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    display: grid;
    gap: 2px;
    padding: 8px var(--gutter) 14px;
    background: var(--bg-raised);
    border-bottom: 1px solid var(--line);
    box-shadow: var(--shadow);
  }
  .menu ul a { display: block; padding: 10px 0; font-size: 1.05rem; color: var(--ink); }
  .footer { border-top: 1px solid var(--line); padding: 40px 0 56px; background: var(--bg-sunken); }
  .footer-inner { display: grid; grid-template-columns: 1fr auto; gap: 32px; align-items: start; }
  .footer-links { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  @media (max-width: 959px) {
    .nav-links { display: none; }
    .menu { display: block; }
  }
  @media (max-width: 639px) {
    .header-end { gap: 6px; }
    .footer-inner { grid-template-columns: 1fr; }
    .footer-links { grid-template-columns: repeat(2, 1fr); gap: 10px 16px; }
    .brand { font-size: 0.95rem; }
  }
  @media (max-width: 399px) {
    .header-inner { gap: 8px; }
    .brand { gap: 8px; font-size: 0.88rem; min-width: 0; }
    .brand span:last-child { overflow: hidden; text-overflow: ellipsis; }
    .menu summary { padding: 6px 12px; }
    .github { width: 32px; }
  }
</style>
