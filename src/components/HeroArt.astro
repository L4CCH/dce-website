---
import { path } from '../site';

const collection = [
  { file: 'photo.jpg', x: 16, label: 'Photographs' },
  { file: 'map.jpg', x: 108, label: 'Maps' },
  { file: 'letter.jpg', x: 200, label: 'Documents' },
];

const results = ['result-1.jpg', 'result-2.jpg', 'result-3.jpg', 'result-4.jpg'];
---

<svg class="art" viewBox="0 0 560 424" role="img" aria-label="Photographs, maps and documents from a collection, and a visitor's search for a bird's-eye view of a harbor, go through an open model, SigLIP or CLIP, which returns the most similar images first: bird's-eye views of Amsterdam, Ostend, Boston and New Orleans." xmlns="http://www.w3.org/2000/svg">
  <defs>
    <marker id="hero-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" class="arrow-head" />
    </marker>
    <clipPath id="hero-square" clipPathUnits="objectBoundingBox">
      <rect width="1" height="1" rx="0.1" ry="0.1" />
    </clipPath>
    <clipPath id="hero-wide" clipPathUnits="objectBoundingBox">
      <rect width="1" height="1" rx="0.065" ry="0.087" />
    </clipPath>
  </defs>

  <rect x="0" y="0" width="296" height="160" rx="14" class="card" />
  <text x="16" y="28" class="label strong">Your collection</text>
  {collection.map((item) => (
    <g>
      <image href={path(`/hero/${item.file}`)} x={item.x} y="42" width="80" height="80" preserveAspectRatio="xMidYMid slice" clip-path="url(#hero-square)" />
      <rect x={item.x} y="42" width="80" height="80" rx="8" class="frame" />
      <text x={item.x + 40} y="142" text-anchor="middle" class="caption">{item.label}</text>
    </g>
  ))}

  <text x="316" y="28" class="label strong">A visitor's search</text>
  <rect x="316" y="42" width="244" height="40" rx="20" class="field" />
  <circle cx="335" cy="61" r="6" class="glyph" />
  <path d="M339.5 65.5 L 344 70" class="glyph" />
  <text x="352" y="67" class="query">a bird's-eye view of a harbor</text>

  <path d="M148 162 C 148 186, 232 178, 232 200" class="flow" marker-end="url(#hero-arrow)" />
  <text x="138" y="186" text-anchor="end" class="caption">indexed once</text>
  <path d="M438 84 C 438 150, 328 160, 328 200" class="flow" marker-end="url(#hero-arrow)" />
  <text x="448" y="124" class="caption">each search</text>

  <rect x="188" y="204" width="184" height="56" rx="14" class="card" />
  <text x="280" y="228" text-anchor="middle" class="label strong">Open model</text>
  <text x="280" y="247" text-anchor="middle" class="caption">SigLIP or CLIP, locally</text>

  <path d="M280 262 L 280 294" class="flow" marker-end="url(#hero-arrow)" />
  <text x="292" y="284" class="caption">most similar first</text>

  <rect x="0" y="300" width="560" height="124" rx="14" class="card" />
  {results.map((file, i) => (
    <g>
      <image href={path(`/hero/${file}`)} x={16 + i * 135} y="316" width="123" height="92" preserveAspectRatio="xMidYMid slice" clip-path="url(#hero-wide)" />
      <rect x={16 + i * 135} y="316" width="123" height="92" rx="8" class="frame" />
    </g>
  ))}
</svg>

<style>
  .art { width: 100%; height: auto; display: block; font-family: var(--font-body); -webkit-user-select: none; user-select: none; }
  .card { fill: var(--bg-raised); stroke: var(--line); stroke-width: 1.5; }
  .frame { fill: none; stroke: var(--line); stroke-width: 1; }
  .label { font-size: 15px; fill: var(--ink-soft); }
  .strong { fill: var(--ink); font-weight: 700; font-family: var(--font-display); }
  .caption { font-size: 13px; fill: var(--ink-soft); }
  .flow { fill: none; stroke: var(--ink-faint); stroke-width: 1.5; stroke-dasharray: 4 5; }
  .arrow-head { fill: var(--ink-faint); }
  .field { fill: #fff; stroke: var(--line); stroke-width: 1.5; }
  .glyph { fill: none; stroke: var(--ink-soft); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .query { font-size: 13px; fill: var(--ink); }
</style>
