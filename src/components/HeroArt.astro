<svg class="art" viewBox="0 0 560 430" role="img" aria-label="A pile of photographs, maps and documents goes through an open model into a search page, where a visitor types a description and sees matching images." xmlns="http://www.w3.org/2000/svg">
  <defs>
    <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" class="arrow-head" />
    </marker>
  </defs>

  <g class="pile">
    <g transform="rotate(7 125 70)">
      <rect x="70" y="30" width="110" height="80" rx="8" class="card" />
      <path d="M88 50 H162 M88 64 H162 M88 78 H162 M88 92 H134" class="ink-line" />
    </g>
    <g transform="rotate(-5 95 90)">
      <rect x="40" y="50" width="110" height="80" rx="8" class="card" />
      <path d="M48 112 C 70 96, 80 120, 104 100 S 140 84, 148 74" class="contour" />
      <path d="M46 88 C 66 80, 74 98, 98 82 S 130 64, 146 60" class="contour" />
      <path d="M72 58 L 96 126" class="road" />
    </g>
    <g>
      <rect x="20" y="80" width="120" height="86" rx="8" class="card front" />
      <circle cx="50" cy="106" r="9" class="sun" />
      <path d="M28 158 L 58 120 L 82 144 L 98 130 L 132 158 Z" class="hill" />
    </g>
    <text x="20" y="200" class="label">Your collection</text>
  </g>

  <path d="M150 118 C 200 118, 196 96, 244 96" class="flow" marker-end="url(#arrow)" />

  <g class="model">
    <rect x="250" y="60" width="72" height="72" rx="16" class="card" />
    <g class="dots">
      <circle cx="268" cy="78" r="4" class="on" /><circle cx="286" cy="78" r="4" /><circle cx="304" cy="78" r="4" />
      <circle cx="268" cy="96" r="4" /><circle cx="286" cy="96" r="4" class="on" /><circle cx="304" cy="96" r="4" />
      <circle cx="268" cy="114" r="4" /><circle cx="286" cy="114" r="4" /><circle cx="304" cy="114" r="4" class="on" />
    </g>
    <text x="338" y="90" class="label strong">Open model</text>
    <text x="338" y="112" class="label">SigLIP or CLIP, locally</text>
  </g>

  <path d="M286 134 L 286 184" class="flow" marker-end="url(#arrow)" />

  <g class="search">
    <rect x="230" y="190" width="310" height="228" rx="14" class="card" />
    <rect x="246" y="206" width="278" height="34" rx="17" class="field" />
    <circle cx="265" cy="222" r="6" class="glyph" />
    <path d="M269.5 226.5 L 274 231" class="glyph" />
    <text x="282" y="228" class="query">a harbor with a breakwater</text>
    <rect x="496" y="215" width="18" height="15" rx="3" class="glyph" />
    <path d="M498 228 L 504 221 L 508 225 L 511 222 L 513 226" class="glyph" />

    <g class="tiles">
      <g transform="translate(246 254)">
        <rect width="86" height="68" rx="8" class="tile hit" />
        <path d="M8 56 C 26 42, 34 60, 52 44 S 74 30, 80 24" class="contour" />
        <path d="M6 30 C 24 22, 32 40, 50 26 S 72 12, 80 10" class="contour" />
      </g>
      <g transform="translate(342 254)">
        <rect width="86" height="68" rx="8" class="tile" />
        <circle cx="22" cy="22" r="7" class="sun" />
        <path d="M6 62 L 30 34 L 48 52 L 60 42 L 82 62 Z" class="hill" />
      </g>
      <g transform="translate(438 254)">
        <rect width="86" height="68" rx="8" class="tile" />
        <path d="M14 16 H72 M14 28 H72 M14 40 H72 M14 52 H50" class="ink-line" />
      </g>
      <g transform="translate(246 332)">
        <rect width="86" height="68" rx="8" class="tile" />
        <path d="M6 62 L 26 38 L 44 54 L 56 46 L 82 62 Z" class="hill" />
      </g>
      <g transform="translate(342 332)">
        <rect width="86" height="68" rx="8" class="tile" />
        <path d="M8 50 C 26 36, 34 54, 52 38 S 74 24, 80 18" class="contour" />
        <path d="M20 8 L 40 62" class="road" />
      </g>
      <g transform="translate(438 332)">
        <rect width="86" height="68" rx="8" class="tile" />
        <path d="M14 16 H72 M14 28 H72 M14 40 H58" class="ink-line" />
      </g>
    </g>
  </g>
</svg>

<style>
  .art { width: 100%; height: auto; display: block; font-family: var(--font-body); -webkit-user-select: none; user-select: none; }
  .card { fill: var(--bg-raised); stroke: var(--line); stroke-width: 1.5; }
  .front { filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.18)); }
  .ink-line { fill: none; stroke: var(--ink-faint); stroke-width: 3; stroke-linecap: round; }
  .contour { fill: none; stroke: var(--ink-soft); stroke-width: 1.8; stroke-linecap: round; }
  .road { fill: none; stroke: var(--accent); stroke-width: 2; stroke-linecap: round; stroke-dasharray: 3 4; }
  .sun { fill: var(--accent); }
  .hill { fill: var(--accent-soft); }
  .label { font-size: 16px; fill: var(--ink-soft); }
  .strong { fill: var(--ink); font-weight: 700; font-family: var(--font-display); }
  .flow { fill: none; stroke: var(--ink-faint); stroke-width: 1.5; stroke-dasharray: 4 5; }
  .arrow-head { fill: var(--ink-faint); }
  .dots circle { fill: var(--line); }
  .dots .on { fill: var(--accent); }
  .field { fill: var(--bg-sunken); stroke: var(--line); }
  .glyph { fill: none; stroke: var(--ink-soft); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .query { font-size: 15px; fill: var(--ink); }
  .tile { fill: var(--bg-sunken); stroke: var(--line); }
  .hit { stroke: var(--accent); stroke-width: 2; }
</style>
