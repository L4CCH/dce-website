---
import Section from './Section.astro';
import { site } from '../site';
---

<Section id="cite" eyebrow="Cite" title="Using it in research? Cite the paper">
  <div class="btn-row">
    <a class="btn btn-primary" href={site.paper.url} rel="noopener">Open the paper</a>
  </div>
</Section>

<style>
  .btn-row { margin-top: 0; }
</style>
