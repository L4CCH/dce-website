---
import Section from './Section.astro';
import Copy from './Copy.astro';
import { site } from '../site';

const bibtex = `@article{huang2025digitalcollectionsexplorer,
  title   = {${site.paper.title}},
  author  = {Huang, Ying-Hsiang and Lee, Benjamin Charles Germain},
  journal = {${site.paper.journal}},
  volume  = {${site.paper.volume}},
  pages   = {${site.paper.article}},
  year    = {${site.paper.year}},
  doi     = {${site.paper.doi}}
}`;
---

<Section
  id="cite"
  eyebrow="Cite"
  title="Using it in research? Cite the paper"
  lead="Please cite the paper that describes Digital Collections Explorer. Each software release also has its own DOI, so you can name the exact version you used."
  split
>
  <div class="cite">
    <p class="reference">
      Huang, Y.-H., &amp; Lee, B. C. G. ({site.paper.year}). Digital Collections Explorer: An open-source, multimodal viewer for searching digital collections. <cite>{site.paper.journal}</cite>, <i>{site.paper.volume}</i>, {site.paper.article}. <a href={site.paper.url} rel="noopener">{site.paper.url}</a>
    </p>
    <Copy text={bibtex} label="Copy BibTeX" />
    <ul class="links">
      <li><a href={site.paper.url} rel="noopener">Read the paper, open access</a></li>
      <li><a href={site.paper.arxivUrl} rel="noopener">Preprint on arXiv</a></li>
      <li><a href={site.zenodoUrl} rel="noopener">Find the DOI for each release on Zenodo</a></li>
    </ul>
  </div>
</Section>

<style>
  .reference {
    margin: 0 0 20px;
    padding: 20px 24px;
    border-left: 3px solid var(--accent);
    background: var(--bg-raised);
    border-radius: 0 var(--radius) var(--radius) 0;
    max-width: none;
  }
  .reference cite { font-style: italic; }
  .reference a { overflow-wrap: anywhere; }
  .links { list-style: none; margin: 16px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .links li { margin: 0; }
</style>
