---
interface Props {
  query: string;
  kind: 'photo' | 'map' | 'doc';
}
const { query, kind } = Astro.props;
const tiles = [0, 1, 2];
---

<div class="example">
  <p class="query"><span class="sr-only">Example search: </span>“{query}”</p>
  <svg class="arrow" viewBox="0 0 48 40" aria-hidden="true">
    <defs>
      <marker id={`tip-${kind}`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="currentColor" />
      </marker>
    </defs>
    <path d="M4 12 C 14 -2, 34 -2, 43 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" marker-end={`url(#tip-${kind})`} />
  </svg>
  <svg class="result" viewBox="0 0 268 72" role="img" aria-label={`What a search for ${query} finds`}>
    {tiles.map((i) => (
      <g transform={`translate(${i * 92} 0)`}>
        <rect width="84" height="72" rx="8" class:list={['tile', { hit: i === 0 }]} />
        {kind === 'photo' && (
          <>
            <circle cx="22" cy="22" r="7" class="sun" />
            <path d="M6 64 L 28 38 L 46 56 L 58 46 L 78 64 Z" class="hill" />
          </>
        )}
        {kind === 'map' && (
          <>
            <path d="M8 52 C 26 38, 34 56, 52 40 S 74 26, 78 20" class="contour" />
            <path d="M8 34 C 24 26, 34 44, 52 28 S 72 14, 78 8" class="contour" />
            <path d="M22 8 L 42 64" class="road" />
          </>
        )}
        {kind === 'doc' && <path d="M14 18 H70 M14 30 H70 M14 42 H70 M14 54 H48" class="ink-line" />}
      </g>
    ))}
  </svg>
</div>

<style>
  .example { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 14px; }
  .query { margin: 0; font-style: italic; color: var(--ink); }
  .arrow { width: 44px; height: 36px; flex: none; color: var(--accent); }
  .result { width: 100%; max-width: 232px; height: auto; }
  .tile { fill: var(--bg-sunken); stroke: var(--line); }
  .hit { stroke: var(--accent); stroke-width: 2; }
  .sun { fill: var(--accent); }
  .hill { fill: var(--accent-soft); }
  .contour { fill: none; stroke: var(--ink-soft); stroke-width: 1.8; stroke-linecap: round; }
  .road { fill: none; stroke: var(--accent); stroke-width: 2; stroke-linecap: round; stroke-dasharray: 3 4; }
  .ink-line { fill: none; stroke: var(--ink-faint); stroke-width: 3; stroke-linecap: round; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  svg { user-select: none; }
</style>
