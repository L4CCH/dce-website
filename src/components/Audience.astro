---
import Section from './Section.astro';
import { path } from '../site';

const cases = [
  {
    title: 'Photographs nobody has cataloged',
    text: 'Thousands of scans named IMG_2041.jpg. Point it at the folder and visitors can search them the same afternoon.',
    image: '/screens/photos.jpg',
    alt: 'A search for children playing in the snow, answered with a greeting card, a snowy Hiroshige print and a skating scene',
  },
  {
    title: 'Maps, plans and drawings',
    text: 'Search by what is drawn rather than what the title says, and open a large sheet in deep zoom.',
    image: '/screens/maps.jpg',
    alt: "A search for a bird's-eye view of a city, answered with panoramic views of St. Louis and Boston",
  },
  {
    title: 'Born-digital and scanned documents',
    text: 'PDFs are indexed page by page and searched by what each page looks like, so handwriting, diagrams and forms are found without OCR.',
    image: '/screens/documents.jpg',
    alt: 'A search for a handwritten letter, answered first with handwritten pages from the Smithsonian Institution Archives',
  },
  {
    title: 'Objects scanned in 3D',
    text: "Visitors turn the model on the object's page. Views drawn from it are searched with the photographs, and similar shapes are a click away.",
    image: '/screens/3d.jpg',
    alt: "The 3D model of Charlie Parker's alto saxophone on its page, above the object's photographs",
  },
];
---

<Section
  id="who"
  eyebrow="Who it is for"
  title="Collections that are hard to search"
  lead="Manual cataloging does not scale to millions of items, so many digitized and born-digital collections lack basic descriptive metadata, or have it for some items and not others. Search here compares a visitor's words with what the images show, and reads the catalog wherever there is one."
  split
>
  <ul class="cases">
    {cases.map((c) => (
      <li>
        <h3>{c.title}</h3>
        <p>{c.text}</p>
        <img src={path(c.image)} alt={c.alt} loading="lazy" />
      </li>
    ))}
  </ul>
</Section>

<style>
  .cases { list-style: none; margin: 0; padding: 0; }
  .cases li { margin: 0; padding: 28px 0; border-top: 1px solid var(--line); }
  .cases li:first-child { padding-top: 0; border-top: 0; }
  .cases li:last-child { padding-bottom: 0; }
  .cases h3 { font-size: 1.2rem; margin-bottom: 0.4em; }
  .cases p { color: var(--ink-soft); margin-bottom: 14px; }
  .cases img { display: block; width: 100%; height: auto; border-radius: calc(var(--radius) - 4px); border: 1px solid var(--line); }
</style>
