---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Section from './Section.astro';
import { searchUrl, showcases } from '../site';
import { widthsOf } from '../lib/images';

const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/showcases/*', { eager: true });
const shotOf = (image: string) => shots[`../assets${image}`].default;
---

<Section id="showcases" eyebrow="Showcase" title="Try it on a real collection">
  <ul class="showcases">
    {showcases.map((s) => (
      <li class="card showcase">
        <a class="shot" href={s.url} rel="noopener">
          <Picture src={shotOf(s.image)} alt={s.alt} formats={['avif', 'webp']} widths={widthsOf(shotOf(s.image))} sizes="(min-width: 1200px) 624px, (min-width: 960px) 50vw, 84vw" loading="lazy" decoding="async" />
        </a>
        <div>
          <h3><a href={s.url} rel="noopener">{s.name}</a></h3>
          <p class="muted">{s.summary}</p>
          <p class="try-label">Try</p>
          <ul class="tries">
            {s.tries.map((query) => (
              <li><a href={searchUrl(s, query)} rel="noopener">“{query}”</a></li>
            ))}
          </ul>
        </div>
      </li>
    ))}
  </ul>
</Section>

<style>
  .showcases { list-style: none; margin: 0; padding: 0; display: grid; gap: 20px; }
  .showcases > li { margin: 0; }
  .showcase { display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px; align-items: center; }
  .shot { display: block; border-radius: calc(var(--radius) - 4px); overflow: hidden; border: 1px solid var(--line); background: #121212; }
  .shot :global(picture) { display: block; }
  .shot :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; }
  .showcase h3 { margin-bottom: 0.3em; }
  .showcase h3 a { color: var(--ink); text-decoration: none; }
  .showcase h3 a:hover { text-decoration: underline; }
  .try-label { margin: 18px 0 8px; font-size: 0.85rem; font-weight: 700; color: var(--ink-soft); }
  .tries { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .tries li { margin: 0; }
  .tries a { display: inline-block; font-style: italic; padding: 6px 12px; border-radius: 999px; border: 1px solid var(--line); background: var(--bg-raised); color: var(--ink); text-decoration: none; }
  .tries a:hover { border-color: var(--accent); background: var(--accent-soft); }
  @media (pointer: coarse) {
    .tries a { padding: 10px 14px; }
  }
  @media (min-width: 960px) {
    .showcase { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: 32px; }
  }
</style>
