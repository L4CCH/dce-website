---
import Section from './Section.astro';
import { site, templates } from '../site';
---

<Section
  id="templates"
  eyebrow="Templates"
  title="Three interfaces, one index format"
  lead="Choose the interface that suits the material. Each is a small React app you can restyle, and each talks to the same backend."
>
  <div class="tabs" data-tabs>
    <div role="tablist" aria-label="Interface templates">
      {templates.map((t, i) => (
        <button role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} type="button">
          {t.name}
        </button>
      ))}
    </div>
    {templates.map((t, i) => (
      <div role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} hidden={i !== 0} class="panel">
        <div class="panel-text">
          <h3>{t.name}</h3>
          <p>{t.lead}</p>
          <ul>{t.features.map((f) => <li>{f}</li>)}</ul>
          <p class="faint">
            Source: <a href={`${site.repoUrl}/tree/main/src/frontend/${t.id}`} rel="noopener"><code>src/frontend/{t.id}</code></a>
          </p>
        </div>
        <div class="panel-demo">
          {t.live ? (
            <>
              <iframe data-src={t.demo} title={`${t.name} demo`} loading="lazy" referrerpolicy="no-referrer"></iframe>
              <p class="faint demo-links"><a href={t.demo}>Open the {t.name.toLowerCase()} demo in its own tab</a></p>
            </>
          ) : (
            <div class="placeholder">
              <p><strong>Live demo opens with v2.0.0.</strong></p>
              <p class="muted">Until then, run it yourself in two commands, or read the interface's source on GitHub.</p>
              <a class="btn" href="#start">Run it yourself</a>
            </div>
          )}
        </div>
      </div>
    ))}
  </div>
</Section>

<script>
  const root = document.querySelector<HTMLElement>('[data-tabs]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const show = (index: number) => {
      tabs.forEach((tab, i) => {
        tab.setAttribute('aria-selected', String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
      });
      panels.forEach((panel, i) => {
        panel.hidden = i !== index;
        const frame = panel.querySelector<HTMLIFrameElement>('iframe[data-src]');
        if (i === index && frame && !frame.src) frame.src = frame.dataset.src ?? '';
      });
      tabs[index].focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => show(i));
      tab.addEventListener('keydown', (event) => {
        const step = { ArrowRight: 1, ArrowLeft: -1, Home: -i, End: tabs.length - 1 - i }[event.key];
        if (step !== undefined) {
          event.preventDefault();
          show((i + step + tabs.length) % tabs.length);
        }
      });
    });
    const first = panels[0]?.querySelector<HTMLIFrameElement>('iframe[data-src]');
    if (first) first.src = first.dataset.src ?? '';
  }
</script>

<style>

  [role='tablist'] { display: flex; gap: 6px; border-bottom: 1px solid var(--line); margin-bottom: 24px; }
  [role='tab'] {
    font: inherit;
    font-family: var(--font-display);
    font-weight: 700;
    background: none;
    border: 0;
    border-bottom: 3px solid transparent;
    color: var(--ink-soft);
    padding: 10px 14px;
    margin-bottom: -1px;
    cursor: pointer;
  }
  [role='tab'][aria-selected='true'] { color: var(--ink); border-bottom-color: var(--accent); }
  .panel { display: grid; grid-template-columns: minmax(260px, 2fr) minmax(300px, 3fr); gap: 32px; align-items: start; }
  .panel[hidden] { display: none; }
  .panel-text ul { padding-left: 1.1em; color: var(--ink-soft); }
  .panel-demo { position: sticky; top: 76px; }
  iframe {
    width: 100%;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #121212;
    box-shadow: var(--shadow);
  }
  .demo-links { margin-top: 8px; }
  .placeholder {
    aspect-ratio: 4 / 3;
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    background: var(--bg-sunken);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 32px;
  }
  .placeholder p { margin-bottom: 0.5em; }
  .placeholder .btn { margin-top: 12px; }
  @media (max-width: 959px) {
    .panel { grid-template-columns: 1fr; gap: 20px; }
    .panel-demo { position: static; }
    [role='tablist'] { overflow-x: auto; scrollbar-width: none; }
    [role='tab'] { white-space: nowrap; }
    .placeholder { padding: 20px; }
  }
</style>
