---
import { site } from '../site';
import HeroArt from './HeroArt.astro';
import type { RepoStats } from '../lib/github';

interface Props { stats: RepoStats }
const { stats } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div>
      <p class="eyebrow">Open source · Self-hosted · Made for galleries, libraries, archives and museums</p>
      <h1 id="hero-title">{site.tagline}</h1>
      <p class="lead">
        Digital Collections Explorer is an open-source platform for exploratory search over digital collections
        with visual features: photographs, maps, documents and 3D models. Visitors search in natural language or with an
        image, so a collection can be discovered even when it has little or no descriptive metadata. Where a
        catalog exists, search reads the records too. It runs on a laptop, a server or the cloud, and the
        collection never leaves your hands.
      </p>
      <div class="btn-row">
        <a class="btn btn-primary" href="#showcases">See it working</a>
        <a class="btn" href="#start">Get started</a>
        <a class="btn" href={site.repoUrl} rel="noopener">
          GitHub{stats.stars !== null && <span class="stars" aria-label={`${stats.stars} stars`}>★ {stats.stars}</span>}
        </a>
      </div>
    </div>
    <div class="hero-art"><HeroArt /></div>
  </div>
</section>

<style>
  .hero { padding: clamp(64px, 12vw, 140px) 0 clamp(48px, 8vw, 96px); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 11fr) minmax(0, 9fr); gap: 48px; align-items: center; }
  .hero-art { max-width: 560px; }
  @media (max-width: 959px) {
    .hero-grid { grid-template-columns: 1fr; gap: 40px; }
    .hero-art { max-width: 480px; }
  }
  .hero h1 { max-width: 20ch; }
  .hero .lead { max-width: 56ch; font-size: 1.25rem; }
  .stars { font-weight: 400; color: var(--ink-soft); }
  @media (max-width: 639px) {
    .hero-art { display: none; }
    .hero { padding-top: 48px; }
    .hero .lead { font-size: 1.1rem; }
  }
</style>
