---
import { site } from '../site';
import HeroArt from './HeroArt.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div>
      <p class="eyebrow">Made for galleries, libraries, archives, and museums</p>
      <h1 id="hero-title">{site.tagline}</h1>
      <p class="lead">
        Digital Collections Explorer is open source. Point it at a folder or an S3 bucket, and in a few steps you have a
        website where visitors search in natural language or with an image, with or without a catalog.
      </p>
    </div>
    <div class="hero-art"><HeroArt /></div>
  </div>
</section>

<style>
  .hero { padding: clamp(48px, 8vw, 96px) 0; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 11fr) minmax(0, 9fr); gap: 48px; align-items: center; }
  .hero-art { max-width: 560px; }
  @media (max-width: 959px) {
    .hero-grid { grid-template-columns: 1fr; gap: 40px; }
    .hero-art { max-width: 480px; }
  }
  .hero h1 { max-width: 20ch; }
  .hero .lead { max-width: 56ch; font-size: 1.25rem; margin-bottom: 0; }
  @media (max-width: 639px) {
    .hero { padding-top: 48px; }
    .hero .lead { font-size: 1.1rem; }
  }
</style>
