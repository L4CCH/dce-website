---
import Section from './Section.astro';
import { path } from '../site';

const steps = [
  {
    title: 'Point it at a collection',
    text: 'A folder, an S3 bucket, or a parquet manifest of images and their catalog. A profile of the collection first shows what it holds, what the site will do with it and what indexing will cost.',
  },
  {
    title: 'Build the index',
    text: 'An open multimodal model embeds every image on a machine you control. No image is sent to an external API.',
  },
  {
    title: 'Open the search site',
    text: 'Visitors search in natural language or with an image, across photographs, maps, documents and 3D models. Where a catalog exists, search weighs what the images show against what the records say, and tells the visitor how it read the query.',
  },
];

const papers = {
  siglip: 'https://openaccess.thecvf.com/content/ICCV2023/html/Zhai_Sigmoid_Loss_for_Language_Image_Pre-Training_ICCV_2023_paper.html',
  siglip2: 'https://arxiv.org/abs/2502.14786',
  clip: 'https://proceedings.mlr.press/v139/radford21a.html',
};

const examples = [
  {
    kind: 'A name',
    text: 'is looked up in the records, so “amelia earhart” finds what is cataloged under her name.',
    query: 'amelia earhart',
    results: [
      { file: 'name-1.jpg', width: 400, height: 247, alt: "Amelia Earhart 'Round The World Flight' envelope signed by Amelia Earhart, National Postal Museum" },
      { file: 'name-2.jpg', width: 398, height: 400, alt: "Token commemorating Amelia Earhart's first transatlantic flight, National Postal Museum" },
      { file: 'name-3.jpg', width: 361, height: 365, alt: 'Medal presented to Amelia Earhart, National Postal Museum' },
      { file: 'name-4.jpg', width: 400, height: 247, alt: "Amelia Earhart 'Round The World Flight' envelope, National Postal Museum" },
    ],
  },
  {
    kind: 'A description',
    text: `is matched against the pictures by an open model, such as <a href="${papers.siglip}" rel="noopener">SigLIP</a>, <a href="${papers.siglip2}" rel="noopener">SigLIP 2</a> or <a href="${papers.clip}" rel="noopener">CLIP</a>. None of these records mentions a handshake.`,
    query: 'two men shaking hands',
    results: [
      { file: 'description-1.jpg', width: 263, height: 400, alt: 'Samuel Clemens and John T. Raymond shaking hands, a photograph, National Portrait Gallery' },
      { file: 'description-2.jpg', width: 295, height: 400, alt: 'Silhouettes of David Osgood and George Parker facing each other, National Portrait Gallery' },
      { file: 'description-3.jpg', width: 310, height: 400, alt: 'Silhouettes of Nathan Crocker and William Goddard facing each other, National Portrait Gallery' },
      { file: 'description-4.jpg', width: 309, height: 400, alt: 'Silhouettes of Theodore McCaleb and Isaac Johnson facing each other, National Portrait Gallery' },
    ],
  },
];
---

<Section id="how" eyebrow="How it works" title="From a collection to a search site in three steps">
  <ol class="steps">
    {steps.map((step, i) => (
      <li>
        <span class="num" aria-hidden="true">{i + 1}</span>
        <h3>{step.title}</h3>
        <p>{step.text}</p>
      </li>
    ))}
  </ol>
  <div class="search">
    <h3>How search works</h3>
    <div class="search-cases">
      {examples.map((example) => (
        <figure>
          <p class="query">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg>
            {example.query}
          </p>
          <ul class="results">
            {example.results.map((result) => (
              <li><img src={path(`/results/${result.file}`)} alt={result.alt} width={result.width} height={result.height} loading="lazy" /></li>
            ))}
          </ul>
          <figcaption><strong>{example.kind}</strong> <Fragment set:html={example.text} /></figcaption>
        </figure>
      ))}
    </div>
  </div>
</Section>

<style>
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 32px; }
  @media (min-width: 960px) {
    .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; }
  }
  .steps > li { margin: 0; padding-top: 20px; border-top: 2px solid var(--line); }
  .num {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
    font-family: var(--font-display);
    font-weight: 700;
    margin-bottom: 14px;
  }
  .steps h3 { font-size: 1.15rem; margin-bottom: 0.4em; }
  .steps p { margin-bottom: 0; }
  .search { margin: 48px 0 0; padding-top: 24px; border-top: 1px solid var(--line); }
  .search h3 { font-size: 1.15rem; margin-bottom: 0; }
  .search-cases { display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px; margin-top: 16px; }
  @media (min-width: 960px) {
    .search-cases { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  }
  .search-cases figure { margin: 0; padding: 16px; background: var(--bg-raised); border: 1px solid var(--line); border-radius: var(--radius); }
  .query { display: flex; align-items: center; gap: 10px; max-width: none; margin: 0; padding: 10px 16px; background: #fff; border: 1px solid var(--line); border-radius: 999px; color: var(--ink); font-size: 1.05rem; }
  .query svg { flex: none; width: 18px; height: 18px; fill: none; stroke: var(--ink-faint); stroke-width: 2; stroke-linecap: round; }
  .results { list-style: none; margin: 14px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  @media (min-width: 560px) {
    .results { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .results li { margin: 0; }
  .results img { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: contain; padding: 6px; background: var(--bg-sunken); border-radius: 6px; }
  .search-cases figcaption { margin-top: 14px; color: var(--ink-soft); }
</style>
