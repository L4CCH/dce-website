---
import Section from './Section.astro';
import { path } from '../site';

const ways = [
  {
    href: '/docs/indexing/#with-an-ai-coding-agent',
    title: 'With an AI coding agent',
    text: 'Ask Claude Code, Codex, Gemini CLI or Cursor to make your collection searchable.',
  },
  {
    href: '/docs/indexing/#with-docker',
    title: 'With Docker',
    text: 'One command builds the index, another serves it.',
  },
  {
    href: '/docs/deploy/server/',
    title: 'On a server or AWS',
    text: 'One command keeps a site running. On AWS it shows the cost first.',
  },
];
---

<Section id="start" eyebrow="Get started" title="Three ways to start">
  <ul class="ways">
    {ways.map((way) => (
      <li class="card way">
        <h3><a href={path(way.href)}>{way.title}</a></h3>
        <p class="muted">{way.text}</p>
      </li>
    ))}
  </ul>
</Section>

<style>
  .ways { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px; }
  .ways li { margin: 0; }
  .way h3 { font-size: 1.15rem; margin-bottom: 0.4em; }
  .way h3 a { color: var(--ink); }
  .way p { margin-bottom: 0; }
  @media (min-width: 960px) {
    .ways { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
