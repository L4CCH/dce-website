---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Audience from '../components/Audience.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Templates from '../components/Templates.astro';
import Start from '../components/Start.astro';
import Community from '../components/Community.astro';
import { repoStats, topIdeas, goodFirstIssues } from '../lib/github';

const [stats, ideas, issues] = await Promise.all([repoStats(), topIdeas(), goodFirstIssues()]);
---

<Base>
  <Hero stats={stats} />
  <Audience />
  <HowItWorks />
  <Templates />
  <Start />
  <Community ideas={ideas} issues={issues} />
</Base>
