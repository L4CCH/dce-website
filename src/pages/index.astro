---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Audience from '../components/Audience.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Start from '../components/Start.astro';
import Showcases from '../components/Showcases.astro';
import Assistants from '../components/Assistants.astro';
import Community from '../components/Community.astro';
import Cite from '../components/Cite.astro';
import { repoStats, topIdeas, goodFirstIssues } from '../lib/github';

const [stats, ideas, issues] = await Promise.all([repoStats(), topIdeas(), goodFirstIssues()]);
---

<Base>
  <Hero stats={stats} />
  <Audience />
  <HowItWorks />
  <Showcases />
  <Assistants />
  <Start />
  <Community ideas={ideas} issues={issues} />
  <Cite />
</Base>
