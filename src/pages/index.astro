---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Audience from '../components/Audience.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Templates from '../components/Templates.astro';
import Start from '../components/Start.astro';
import { repoStats } from '../lib/github';

const stats = await repoStats();
---

<Base>
  <Hero stats={stats} />
  <Audience />
  <HowItWorks />
  <Templates />
  <Start />
</Base>
